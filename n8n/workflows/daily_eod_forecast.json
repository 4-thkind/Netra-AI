      "name": "Fetch 7-Day Projected Cash Flow",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [450, 300]
    },
    {
      "parameters": {
        "url": "http://backend:8000/api/v1/merchant/voice-signal",
