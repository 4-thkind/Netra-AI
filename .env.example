# NETRĀ Environment Configuration

# Core Runtime
APP_NAME=Netra
APP_ENV=development
DEBUG=true
PORT=8000
DEMO_MODE=true

# Security & Secrets
SECRET_KEY=netra-hackathon-super-secret-key-2026-secure-random-bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Privacy Policy Constants
MIN_MARKET_MERCHANTS=10
MIN_CATEGORY_MERCHANTS=8
MAX_SENSITIVE_QUERIES_PER_WINDOW=15
QUERY_WINDOW_HOURS=24
PRIVACY_NOISE_EPSILON=0.1

# Database Configuration (Supports SQLite local fallback & PostgreSQL)
DATABASE_URL=sqlite+aiosqlite:///./netra.db
# For PostgreSQL: postgresql+asyncpg://netra_user:netra_pass@localhost:5432/netra_db

# Redis Configuration (Optional in demo mode: falls back to in-memory store)
REDIS_URL=redis://localhost:6379/0

# External AI & Orchestration Integrations (Mocks available in DEMO_MODE)
SARVAM_API_KEY=mock-sarvam-key
SARVAM_BASE_URL=https://api.sarvam.ai
COGNEE_API_KEY=mock-cognee-key
# Point this at your n8n "Netra Message Webhook" production URL to dispatch
# real WhatsApp messages (import n8n/workflows/4_whatsapp_merchant_delivery.json).
# Left unset/default, Netra builds the envelope and reports SIMULATED.
N8N_WEBHOOK_URL=http://localhost:5678/webhook/netra-whatsapp
PAYTM_MERCHANT_KEY=mock-paytm-key

# LLM provider (OpenRouter free tier or NVIDIA NIM)
# Option 1: OpenRouter (Free tier: meta-llama/llama-3.3-70b-instruct:free)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Model order is set by measured reliability on the free tier, not model size.
# Free pools are shared and rate-limit hard, so the client walks this chain and
# only falls through on 429/5xx. Verify a model is still free before pinning it:
#   curl -s https://openrouter.ai/api/v1/models | grep ':free'
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_FALLBACK_MODELS=deepseek/deepseek-v4-flash-0731:free,qwen/qwen3.8-27b:free,google/gemma-4-31b-it:free

# Option 2: NVIDIA NIM (1,000 free credits: meta/llama-3.3-70b-instruct)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.3-70b-instruct

